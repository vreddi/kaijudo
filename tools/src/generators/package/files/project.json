{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "<%= packageFullName %>",
  "projectType": "library",
  "sourceRoot": "src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsup",
        "cwd": "."
      },
      "outputs": ["dist"]
    },
    "storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "storybook dev -p 6006",
        "cwd": "."
      }
    },
    "build-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "storybook build",
        "cwd": "."
      },
      "outputs": ["storybook-static"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "."
      }
    }
  }
}

