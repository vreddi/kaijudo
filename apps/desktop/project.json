{
  "name": "@kaijudo/desktop",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "src",
  "tags": [],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "electron-vite dev",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "electron-vite build",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/out"]
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "electron-vite preview",
        "cwd": "{projectRoot}"
      }
    }
  }
}
