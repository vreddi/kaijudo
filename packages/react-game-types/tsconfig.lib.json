{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "composite": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "noEmit": false
  },
  "include": ["src/**/*"],
  "exclude": ["**/*.spec.ts", "**/*.test.ts", "**/*.stories.ts", ".storybook"]
}

