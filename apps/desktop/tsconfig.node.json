{
  "extends": "../../tsconfig.base.json",
  "include": [
    "electron-vite.config.*",
    "src/main/**/*",
    "src/preload/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "lib": ["ESNext"],
    "emitDeclarationOnly": false,
    "noEmit": false
  }
}
