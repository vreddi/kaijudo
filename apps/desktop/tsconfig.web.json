{
  "extends": "../../tsconfig.base.json",
  "include": ["src/renderer/**/*"],
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "emitDeclarationOnly": false,
    "noEmit": true
  }
}
