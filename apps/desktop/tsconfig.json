{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@convex/*": ["../web/convex/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "../web/convex/**/*"],
  "exclude": ["src-tauri"]
}
